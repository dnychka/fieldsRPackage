set.seed(222)
system.time(
SEout0<- simLocal.spatialProcess( fit1E,COGrid2 ,
ZGrid= COElevGrid2$z,
M= 10)
)
set.seed(222)
system.time(
SEout1<- simLocal.spatialProcess( fit1E,COGrid2 ,
